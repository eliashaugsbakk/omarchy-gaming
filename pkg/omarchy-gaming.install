post_install() {
  echo ":: Omarchy Gaming Mode installed successfully."
  echo ":: "
  echo ":: To enable the bar widget in Omarchy Shell:"
  echo "::   omarchy bar move io.github.elias.gaming --section right"
  echo ":: "
  echo ":: To enable Hyprland overrides when toggled, ensure gaming.lua is linked:"
  echo "::   mkdir -p ~/.local/state/omarchy/toggles/hypr"
  echo "::   cp /usr/share/omarchy/default/hypr/gaming.lua ~/.local/state/omarchy/toggles/hypr/gaming.lua"
  echo ":: "
  echo ":: Optional keybinding for ~/.config/hypr/bindings.lua:"
  echo "::   o.bind(\"SUPER + CTRL + G\", \"Toggle gaming mode\", \"omarchy-gaming-toggle\")"
}

post_upgrade() {
  post_install
}

post_remove() {
  echo ":: Omarchy Gaming Mode removed. You may clean up user-level overrides in ~/.local/state/omarchy/toggles/hypr/gaming.lua if desired."
}
