post_install() {
  printf '\033[1;36m\n╭────────────────────────────────────────────╮\n│ Omarchy Gaming installed                    │\n╰────────────────────────────────────────────╯\033[0m\n'
  if [[ -n "${SUDO_USER:-}" ]] && command -v runuser >/dev/null 2>&1; then
    user_home=$(getent passwd "$SUDO_USER" | cut -d: -f6)
    if [[ -n "$user_home" ]]; then
      runuser -u "$SUDO_USER" -- env HOME="$user_home" /usr/bin/omarchy-gaming-setup --menu-only || \
        echo ":: Could not add the Omarchy Gaming menu entry automatically."
    fi
  fi
  printf '\033[1;33mNext step:\033[0m Open the Omarchy menu and choose \033[1mInstall → Gaming → Gaming Mode\033[0m.\n'
  printf '\033[2mThe wizard configures the user integration, bar plugin, shortcut, and optional GameMode/CachyOS support.\033[0m\n\n'
}

post_upgrade() {
  post_install
}

post_remove() {
  echo ":: Omarchy Gaming Mode package removed."
}
