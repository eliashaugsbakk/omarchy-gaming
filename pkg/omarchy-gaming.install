post_install() {
  echo ":: ========================================================"
  echo ":: Omarchy Gaming Mode installed successfully!"
  echo ":: "
  echo ":: To complete setup (CachyOS kernel, gaming tools, bar widget):"
  echo "::   Run: omarchy-gaming-setup"
  echo ":: "
  echo ":: Or launch 'Gaming Mode Setup' from your application menu (Super)."
  echo ":: ========================================================"
}

post_upgrade() {
  post_install
}

post_remove() {
  echo ":: Omarchy Gaming Mode package removed."
}
