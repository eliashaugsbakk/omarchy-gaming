post_install() {
  printf '\n\033[1;97;44m ACTION REQUIRED \033[0m\n'
  printf '\033[1;94m╭────────────────────────────────────────────╮\n'
  printf '│ Omarchy Gaming was installed               │\n'
  printf '│ Open the Omarchy menu:                     │\n'
  printf '\033[1;97m│   Install → Gaming → Gaming Mode           │\033[1;94m\n'
  printf '╰────────────────────────────────────────────╯\033[0m\n\n'
  if [[ -n "${SUDO_USER:-}" ]] && command -v runuser >/dev/null 2>&1; then
    user_home=$(getent passwd "$SUDO_USER" | cut -d: -f6)
    if [[ -n "$user_home" ]]; then
      runuser -u "$SUDO_USER" -- env HOME="$user_home" /usr/bin/omarchy-gaming-setup --menu-only || \
        echo ":: Could not add the Omarchy Gaming menu entry automatically."
    fi
  fi
  printf '\033[1;33mThe wizard will now configure the integration and ask whether to install optional GameMode or CachyOS support.\033[0m\n\n'
}

post_upgrade() {
  post_install
}

pre_remove() {
  if [[ -n "${SUDO_USER:-}" ]] && command -v runuser >/dev/null 2>&1; then
    user_home=$(getent passwd "$SUDO_USER" | cut -d: -f6)
    if [[ -n "$user_home" ]] && [[ -x /usr/bin/omarchy-gaming-setup ]]; then
      runuser -u "$SUDO_USER" -- env HOME="$user_home" \
        /usr/bin/omarchy-gaming-setup --remove --package-removed || \
        echo ":: Could not remove the Omarchy Gaming user integration automatically."
    fi
  else
    echo ":: Could not identify the desktop user; remove the Omarchy Gaming integration manually."
  fi
  echo ":: Omarchy Gaming package and integration removed."
}
