#!/bin/bash

set -euo pipefail

gaming_flag="$HOME/.local/state/omarchy/toggles/gaming"
gaming_state_dir="$HOME/.local/state/omarchy-gaming"
previous_power_profile="$gaming_state_dir/power-profile-before"
force=0

if [[ ${1:-} == "--force" ]]; then
  force=1
fi

is_on_battery() {
  [[ $(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower org.freedesktop.UPower OnBattery 2>/dev/null) == "b true" ]]
}

is_cachyos_kernel() {
  [[ $(uname -r) =~ cachyos ]]
}

is_cachyos_kernel_installed() {
  command -v pacman >/dev/null 2>&1 && pacman -Q linux-cachyos >/dev/null 2>&1
}

save_power_profile() {
  local profile

  profile=$(powerprofilesctl get 2>/dev/null || true)
  case "$profile" in
    power-saver|balanced|performance)
      mkdir -p "$gaming_state_dir"
      printf '%s\n' "$profile" >"$previous_power_profile"
      ;;
    *)
      rm -f "$previous_power_profile"
      ;;
  esac
}

restore_power_profile() {
  local profile=""

  if [[ -r "$previous_power_profile" ]]; then
    profile=$(<"$previous_power_profile")
  fi

  case "$profile" in
    power-saver|balanced|performance)
      omarchy-powerprofiles-set autodetect "$profile" || true
      ;;
    *)
      # Older installs, unavailable power-profiles-daemon, or an invalid
      # saved value get a conservative desktop default.
      omarchy-powerprofiles-set autodetect power-saver || true
      ;;
  esac
  rm -f "$previous_power_profile"
}

refresh_bar_state() {
  # Notify the already-running bar once instead of polling more frequently.
  # Run asynchronously so shell IPC cannot delay the actual toggle.
  omarchy-shell -q com.github.eliashaugsbakk.omarchy-gaming check >/dev/null 2>&1 &
}

toggle_to_gaming() {
  save_power_profile
  omarchy-toggle gaming on
  refresh_bar_state
  hyprctl reload || true
  omarchy-shell notifications setDnd on || true
  omarchy toggle idle stay-awake || true
  omarchy-toggle screensaver-off off || true
  omarchy-powerprofiles-set autodetect performance || true
}

toggle_to_non_gaming() {
  omarchy-toggle gaming off
  refresh_bar_state
  hyprctl reload || true
  omarchy-shell notifications setDnd off || true
  omarchy toggle idle allow-idle || true
  omarchy-toggle screensaver-off on || true
  restore_power_profile
}

if [[ -f $gaming_flag ]]; then
  toggle_to_non_gaming
else
  if (( !force )); then
    reasons=()

    if is_on_battery; then
      reasons+=("Not plugged into AC")
    fi

    if is_cachyos_kernel_installed && ! is_cachyos_kernel; then
      reasons+=("Running non-CachyOS kernel ($(uname -r))")
    fi

    if ((${#reasons[@]} > 0)); then
      body=$(IFS=" & "; echo "${reasons[*]}")
      omarchy-notification-send -u critical -g "󰊴" "Gaming mode warning" "${body}. Click to enable anyway." --exec "$0" --force || true
      exit 0
    fi
  fi

  toggle_to_gaming
fi
