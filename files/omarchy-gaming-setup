#!/bin/bash
#
# omarchy-gaming-setup
# Interactive setup wizard for Omarchy Gaming Mode
#

set -euo pipefail

STATE_DIR="$HOME/.local/state/omarchy-gaming"
STATE_FILE="$STATE_DIR/ownership"
MENU_EXTENSION="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"

for arg in "$@"; do
  case "$arg" in
    --remove|--uninstall) mode=remove ;;
    --help|-h)
      echo "Usage: omarchy-gaming-setup [--remove]"
      exit 0
      ;;
  esac
done

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

info()    { printf "${BLUE}::${NC} %s\n" "$*"; }
success() { printf "${GREEN}✓${NC} %s\n" "$*"; }
warn()    { printf "${YELLOW}⚠${NC} %s\n" "$*"; }
error()   { printf "${RED}✗${NC} %s\n" "$*" >&2; }
header()  { printf "\n${BOLD}%s${NC}\n" "$*"; }

state_value() {
  local key="$1"
  local value
  value=$(awk -F= -v key="$key" '$1 == key { print $2; exit }' "$STATE_FILE" 2>/dev/null || true)
  case "$value" in
    0|1) printf '%s\n' "$value" ;;
    *) printf '0\n' ;;
  esac
}

remove_menu_entries() {
  [[ -f "$MENU_EXTENSION" ]] || return 0
  python3 - "$MENU_EXTENSION" <<'PY'
import sys
from pathlib import Path

path = Path(sys.argv[1])
text = path.read_text()
for key in ("install.gaming.omarchy-gaming", "remove.gaming.omarchy-gaming"):
    import re
    text = re.sub(r'^\s*"' + re.escape(key) + r'":\s*\{[^\n]*\},?\n?', '', text, flags=re.MULTILINE)
path.write_text(text)
PY
}

install_menu_entries() {
  mkdir -p "$(dirname "$MENU_EXTENSION")"
  [[ -f "$MENU_EXTENSION" ]] || printf '{\n}\n' > "$MENU_EXTENSION"
  python3 - "$MENU_EXTENSION" <<'PY'
import sys
from pathlib import Path

path = Path(sys.argv[1])
text = path.read_text()
if '"install.gaming.omarchy-gaming"' in text:
    raise SystemExit
if not text.rstrip().endswith('}'):
    raise SystemExit("menu extension does not end with an object")
body = text.rstrip()[:-1].rstrip()
if body and not body.endswith(','):
    body += ','
entries = '''
  "install.gaming.omarchy-gaming": {"icon":"󰊴","label":"Omarchy Gaming Mode","when":"[[ ! -f \\"$HOME/.local/state/omarchy-gaming/installed\\" ]]","action":"omarchy-launch-floating-terminal-with-presentation omarchy-gaming-setup"},
  "remove.gaming.omarchy-gaming": {"icon":"󰊴","label":"Omarchy Gaming Mode","when":"[[ -f \\"$HOME/.local/state/omarchy-gaming/installed\\" ]]","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-gaming-setup --remove'"}
'''
path.write_text(body + entries + '}\n')
PY
}

remove_installation() {
  header "Removing Omarchy Gaming"
  if [[ ! -f "$STATE_FILE" ]]; then
    warn "No setup ownership record found; removing user integration only."
  fi

  [[ "${gaming_flag_added:-0}" == 1 ]] && rm -f "$HOME/.local/state/omarchy/toggles/gaming"
  [[ "${gaming_lua_added:-0}" == 1 ]] && rm -f "$HOME/.local/state/omarchy/toggles/hypr/gaming.lua"
  [[ "${plugin_link_added:-0}" == 1 ]] && rm -f "$HOME/.config/omarchy/plugins/com.github.eliashaugsbakk.omarchy-gaming"
  if [[ "${binding_added:-0}" == 1 && -f "$HOME/.config/hypr/bindings.lua" ]]; then
    sed -i '/-- \[omarchy-gaming\]/,/-- \[\/omarchy-gaming\]/d' "$HOME/.config/hypr/bindings.lua"
  fi
  omarchy plugin disable com.github.eliashaugsbakk.omarchy-gaming 2>/dev/null || true
  remove_menu_entries

  if [[ -f "$STATE_FILE" ]]; then
    # Packages and repositories are removed only when this setup added them.
    # Kernel removal is deliberately confirmed and never attempted while active.
    repo_added=$(state_value repo_added)
    gamemode_added=$(state_value gamemode_added)
    kernel_added=$(state_value kernel_added)
    if [[ "$repo_added" == 1 ]] && prompt_yes_no "Remove the CachyOS repository block added by Omarchy Gaming?" n; then
      sudo python3 - <<'PY'
from pathlib import Path
path = Path("/etc/pacman.conf")
text = path.read_text()
start = text.find("# [omarchy-gaming] CachyOS repos")
end = text.find("[core]", start)
if start >= 0 and end >= 0:
    text = text[:start] + text[end:]
    path.write_text(text)
PY
    fi
    if [[ "$gamemode_added" == 1 ]] && prompt_yes_no "Remove GameMode packages installed by this setup?" n; then
      sudo pacman -Rns --noconfirm gamemode lib32-gamemode 2>/dev/null || true
    fi
    if [[ "$kernel_added" == 1 && "$(uname -r)" != *cachyos* ]] && prompt_yes_no "Remove the CachyOS kernel installed by this setup?" n; then
      sudo pacman -Rns --noconfirm linux-cachyos linux-cachyos-headers 2>/dev/null || true
    fi
  fi
  rm -rf "$STATE_DIR"
  hyprctl reload &>/dev/null || true
  success "Omarchy Gaming removed."
  exit 0
}

detect_cachyos_tier() {
  local vendor family model flags

  # Virtual machines may expose the host's CPU model while not reliably
  # supporting the corresponding optimized package ABI. Use generic packages
  # in guests; users can still select CachyOS repos and the kernel manually.
  if grep -qm1 '^flags.*\bhypervisor\b' /proc/cpuinfo; then
    echo "generic"
    return
  fi

  vendor=$(grep -m1 "^vendor_id" /proc/cpuinfo | awk '{print $NF}')
  family=$(grep -m1 "^cpu family" /proc/cpuinfo | awk '{print $NF}')
  model=$(grep -m1 "^model[[:space:]]" /proc/cpuinfo | awk '{print $NF}')
  flags=$(grep -m1 "^flags" /proc/cpuinfo)

  if [[ "$vendor" == "AuthenticAMD" ]]; then
    if (( family == 26 )) || { (( family == 25 )) && (( model >= 96 )); }; then
      echo "znver4"
      return
    fi
    if (( family == 25 )); then
      echo "znver3"
      return
    fi
  fi

  if echo "$flags" | grep -qw "avx512f"; then
    echo "x86-64-v4"
    return
  fi
  if echo "$flags" | grep -qw "avx2"; then
    echo "x86-64-v3"
    return
  fi

  echo "generic"
}

tier_mirrorlist_file() {
  case "$1" in
    znver4|x86-64-v4)
      echo "/etc/pacman.d/cachyos-v4-mirrorlist"
      ;;
    znver3|x86-64-v3)
      echo "/etc/pacman.d/cachyos-v3-mirrorlist"
      ;;
    *)
      echo "/etc/pacman.d/cachyos-mirrorlist"
      ;;
  esac
}

prompt_yes_no() {
  local prompt="$1"
  local default="${2:-y}"
  if command -v gum >/dev/null 2>&1; then
    if gum confirm "$prompt"; then
      return 0
    else
      return 1
    fi
  else
    local choice
    read -rp "$prompt [Y/n] " choice
    choice="${choice:-$default}"
    [[ "${choice,,}" == "y" || "${choice,,}" == "yes" ]]
  fi
}

mode="${mode:-install}"
if [[ "$mode" == remove ]]; then
  remove_installation
fi

mkdir -p "$STATE_DIR"
if [[ -f "$STATE_FILE" ]]; then
  # Preserve ownership flags across repair/setup runs.
  gamemode_added=$(state_value gamemode_added)
  kernel_added=$(state_value kernel_added)
  repo_added=$(state_value repo_added)
  gaming_flag_added=$(state_value gaming_flag_added)
  gaming_lua_added=$(state_value gaming_lua_added)
  plugin_link_added=$(state_value plugin_link_added)
  binding_added=$(state_value binding_added)
else
  gamemode_added=0
  kernel_added=0
  repo_added=0
  gaming_flag_added=0
  gaming_lua_added=0
  plugin_link_added=0
  binding_added=0
fi
: "${gamemode_added:=0}"
: "${kernel_added:=0}"
: "${repo_added:=0}"
: "${gaming_flag_added:=0}"
: "${gaming_lua_added:=0}"
: "${plugin_link_added:=0}"
: "${binding_added:=0}"
if pacman -Q gamemode &>/dev/null || pacman -Q lib32-gamemode &>/dev/null; then
  gamemode_was_installed=1
else
  gamemode_was_installed=0
fi
if pacman -Q linux-cachyos &>/dev/null; then
  kernel_was_installed=1
else
  kernel_was_installed=0
fi
if [[ ! -e "$HOME/.local/state/omarchy/toggles/gaming" && "$gaming_flag_added" == 0 ]]; then gaming_flag_added=1; fi
if [[ ! -e "$HOME/.local/state/omarchy/toggles/hypr/gaming.lua" && "$gaming_lua_added" == 0 ]]; then gaming_lua_added=1; fi
if [[ ! -e "$HOME/.config/omarchy/plugins/com.github.eliashaugsbakk.omarchy-gaming" && "$plugin_link_added" == 0 ]]; then plugin_link_added=1; fi

header "========================================"
header "    Omarchy Gaming Mode Setup Wizard    "
header "========================================"

# --- Step 1: Plugin & Status Bar Setup ---
header "Step 1: Omarchy Bar Widget & Plugin Setup"
echo "Enables the Omarchy top bar widget (󰊴) with live state monitoring."

mkdir -p "$HOME/.config/omarchy/plugins"
mkdir -p "$HOME/.local/state/omarchy/toggles/hypr"

plugin_source=""
if [[ -d /usr/share/omarchy/plugins/com.github.eliashaugsbakk.omarchy-gaming ]]; then
  plugin_source=/usr/share/omarchy/plugins/com.github.eliashaugsbakk.omarchy-gaming
elif [[ -d "$HOME/omarchy-gaming" ]]; then
  plugin_source="$HOME/omarchy-gaming"
fi

sed -i \
  -e "s/^gaming_flag_added=.*/gaming_flag_added=$gaming_flag_added/" \
  -e "s/^gaming_lua_added=.*/gaming_lua_added=$gaming_lua_added/" \
  -e "s/^plugin_link_added=.*/plugin_link_added=$plugin_link_added/" \
  "$STATE_FILE"

if [[ -n "$plugin_source" ]]; then
  ln -sfn "$plugin_source" "$HOME/.config/omarchy/plugins/com.github.eliashaugsbakk.omarchy-gaming"
  success "Plugin linked from $plugin_source"
else
  warn "Gaming plugin files were not found; install the package or clone the repository first."
fi
install_menu_entries

if [[ -f /usr/share/omarchy-gaming/gaming.lua ]]; then
  cp /usr/share/omarchy-gaming/gaming.lua "$HOME/.local/state/omarchy/toggles/hypr/gaming.lua"
elif [[ -f "$HOME/omarchy-gaming/files/gaming.lua" ]]; then
  cp "$HOME/omarchy-gaming/files/gaming.lua" "$HOME/.local/state/omarchy/toggles/hypr/gaming.lua"
fi

if command -v omarchy-shell >/dev/null 2>&1 && [[ -n "$plugin_source" ]]; then
  omarchy-shell shell rescanPlugins || true
fi

if command -v omarchy >/dev/null 2>&1 && [[ -n "$plugin_source" ]]; then
  bar_section="${OMARCHY_GAMING_BAR_SECTION:-right}"
  if [[ ! "$bar_section" =~ ^(left|center|right)$ ]]; then
    warn "Invalid OMARCHY_GAMING_BAR_SECTION='$bar_section'; using right."
    bar_section=right
  fi
  # A discovered plugin is not necessarily enabled or present in the bar.
  # Enable it first; the placement belongs to `plugin enable`.
  if omarchy plugin enable com.github.eliashaugsbakk.omarchy-gaming --section "$bar_section"; then
    success "Plugin activated and placed in the $bar_section bar section."
  else
    warn "Plugin was linked, but Omarchy could not enable/place it in the bar."
  fi
fi

# --- Step 2: Hyprland Keybinding ---
header "Step 2: Hyprland Keybinding"
echo "Add Super + Ctrl + G shortcut to ~/.config/hypr/bindings.lua"

if [[ -f "$HOME/.config/hypr/bindings.lua" ]]; then
  if grep -q "omarchy-gaming-toggle" "$HOME/.config/hypr/bindings.lua"; then
    success "Keybinding already present in bindings.lua"
  else
    if prompt_yes_no "Add 'Super + Ctrl + G' keybinding to bindings.lua?"; then
      cat >> "$HOME/.config/hypr/bindings.lua" <<'BINDING'

-- [omarchy-gaming]
o.bind(
  "SUPER + CTRL + G",
  "Toggle gaming mode",
  "omarchy-gaming-toggle"
)
-- [/omarchy-gaming]
BINDING
      sed -i 's/^binding_added=.*/binding_added=1/' "$STATE_FILE"
      hyprctl reload &>/dev/null || true
      success "Added keybinding to ~/.config/hypr/bindings.lua"
    fi
  fi
fi

# --- Step 3: Optional Gaming Tools ---
header "Step 3: Linux Gaming Tools"
echo "Install GameMode packages: gamemode, lib32-gamemode"
echo "  • gamemode: Auto-renicing and priority scheduling for games"
echo "  • lib32-gamemode: 32-bit GameMode library support"

if prompt_yes_no "Install GameMode?"; then
  if sudo pacman -S --needed --noconfirm gamemode lib32-gamemode; then
    if (( !gamemode_was_installed )); then
      sed -i 's/^gamemode_added=.*/gamemode_added=1/' "$STATE_FILE"
    fi
    success "GameMode installed."
  else
    warn "GameMode installation failed."
  fi
fi

# --- Step 4: CachyOS Kernel & Architecture Repos ---
header "Step 4: Performance Kernel (CachyOS + BORE Scheduler)"
tier=$(detect_cachyos_tier)
echo "Detected CPU optimization tier: ${BOLD}$tier${NC}"
echo ""
echo "PROS:"
echo "  + BORE (Burst-Oriented Response Enhancer) CPU scheduler minimizes frame stutter"
echo "  + Architecture-optimized packages compiled for your specific CPU instructions ($tier)"
echo "  + High-performance default sysctl / vm tweaks"
echo "CONS:"
echo "  - Adds CachyOS pacman repository mirrorlist"
echo "  - Requires sudo and bootloader update / reboot"
echo ""

if prompt_yes_no "Configure CachyOS repos and install linux-cachyos kernel ($tier)?"; then
  cachyos_url="https://mirror.cachyos.org/repo/x86_64/cachyos"
  info "Installing CachyOS keyring..."
  sudo pacman-key --recv-keys F3B607488DB35A47 --keyserver keyserver.ubuntu.com || true
  sudo pacman-key --lsign-key F3B607488DB35A47 || true

  latest_cachyos_pkg() {
    local package_prefix="$1"
    curl -fsSL "$cachyos_url/" \
      | grep -oE "${package_prefix}-[^\"< ]+\.pkg\.tar\.zst" \
      | sort -Vu \
      | tail -n1
  }

  if ! command -v curl >/dev/null 2>&1; then
    error "curl is required to retrieve the current CachyOS package filenames."
    exit 1
  fi

  keyring_pkg=$(latest_cachyos_pkg cachyos-keyring)
  mirrorlist_pkg=$(latest_cachyos_pkg cachyos-mirrorlist)
  case "$tier" in
    znver4|x86-64-v4) optimized_mirrorlist_prefix=cachyos-v4-mirrorlist ;;
    znver3|x86-64-v3) optimized_mirrorlist_prefix=cachyos-v3-mirrorlist ;;
    *) optimized_mirrorlist_prefix="" ;;
  esac
  optimized_mirrorlist_pkg=""
  if [[ -n "$optimized_mirrorlist_prefix" ]]; then
    optimized_mirrorlist_pkg=$(latest_cachyos_pkg "$optimized_mirrorlist_prefix")
  fi
  if [[ -z "$keyring_pkg" || -z "$mirrorlist_pkg" || ( -n "$optimized_mirrorlist_prefix" && -z "$optimized_mirrorlist_pkg" ) ]]; then
    error "Could not find current CachyOS keyring/mirrorlist packages at $cachyos_url"
    exit 1
  fi

  cachyos_packages=(
    "$cachyos_url/$keyring_pkg"
    "$cachyos_url/$mirrorlist_pkg"
  )
  if [[ -n "$optimized_mirrorlist_pkg" ]]; then
    cachyos_packages+=("$cachyos_url/$optimized_mirrorlist_pkg")
  fi
  sudo pacman -U --noconfirm "${cachyos_packages[@]}"

  mirrorlist=$(tier_mirrorlist_file "$tier")
  repo_block="# [omarchy-gaming] CachyOS repos for tier: $tier\n[cachyos-$tier]\nInclude = $mirrorlist\n\n[cachyos-core-$tier]\nInclude = $mirrorlist\n\n[cachyos-extra-$tier]\nInclude = $mirrorlist\n\n[cachyos]\nInclude = /etc/pacman.d/cachyos-mirrorlist\n"

  pacman_arch=""
  case "$tier" in
    znver4|x86-64-v4) pacman_arch="x86_64_v4" ;;
    znver3|x86-64-v3) pacman_arch="x86_64_v3" ;;
  esac

  if ! grep -q "cachyos" /etc/pacman.conf 2>/dev/null; then
    if sudo python3 -c '
import sys
block = sys.argv[1]
with open("/etc/pacman.conf", "r") as f:
    content = f.read()
if "[core]" not in content:
    raise SystemExit("[core] repository was not found in /etc/pacman.conf")
content = content.replace("[core]", block + "\n[core]", 1)
with open("/etc/pacman.conf", "w") as f:
    f.write(content)
' "$(echo -e "$repo_block")"; then
      success "Added CachyOS ($tier) to /etc/pacman.conf"
      sed -i 's/^repo_added=.*/repo_added=1/' "$STATE_FILE"
    else
      error "Could not update /etc/pacman.conf; skipping kernel installation."
      exit 1
    fi
  fi

  if [[ -n "$pacman_arch" ]]; then
    if sudo python3 - "$pacman_arch" <<'PY'
import sys
from pathlib import Path

path = Path("/etc/pacman.conf")
arch = sys.argv[1]
lines = path.read_text().splitlines()
for index, line in enumerate(lines):
    if line.strip().startswith("Architecture ="):
        values = line.split("=", 1)[1].split()
        if arch not in values:
            values.append(arch)
            lines[index] = "Architecture = " + " ".join(values)
        break
else:
    lines.insert(0, "Architecture = auto " + arch)
path.write_text("\n".join(lines) + "\n")
PY
    then
      success "Enabled pacman architecture $pacman_arch"
    else
      error "Could not enable pacman architecture $pacman_arch."
      exit 1
    fi
  fi

  info "Refreshing package databases..."
  sudo pacman -Sy

  info "Installing linux-cachyos kernel and headers..."
  if sudo pacman -S --needed --noconfirm linux-cachyos linux-cachyos-headers; then
    if (( !kernel_was_installed )); then
      sed -i 's/^kernel_added=.*/kernel_added=1/' "$STATE_FILE"
    fi
    success "linux-cachyos installed!"
  else
    warn "Kernel installation failed."
  fi
  warn "Remember to update your bootloader (e.g. 'sudo bootctl update') and reboot into linux-cachyos."
fi

touch "$STATE_DIR/installed"

header "========================================"
success "Omarchy Gaming setup complete!"
header "========================================"
